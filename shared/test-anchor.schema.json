{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gnarly POC test anchor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "zoneId", "position", "coordinateSystem"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "zoneId": { "type": "string", "minLength": 1 },
    "position": {
      "type": "array",
      "description": "[x, y, z] in meters in the capture ARKit world coordinate system.",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "coordinateSystem": { "const": "arkit-world-meters" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
