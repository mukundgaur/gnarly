rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Keep this UID in sync with firestore.rules.
    function isAdmin() {
      return signedIn() && request.auth.uid == "WwvbXcl5hpQgdl8KO79JwcThYJd2";
    }

    // The connection test still uses the client SDK. Package bytes use signed URLs, which bypass these rules.
    match /buildings/firebase-test/{path=**} {
      allow read, write: if isAdmin();
    }

    match /buildings/{buildingId}/{versionId}/{assetPath=**} {
      allow read: if false;
      allow write: if isAdmin() && (
        assetPath.matches('zones/[^/]+/graph-edits/[^/]+\\.json') ||
        assetPath.matches('graph-edits/[^/]+\\.json') ||
        assetPath.matches('building-layout\\.json') ||
        assetPath.matches('zone-connections\\.json')
      );
    }
  }
}
